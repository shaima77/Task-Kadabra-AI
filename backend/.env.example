# Copy to .env and fill in. NEVER commit .env.
# Apify is used only on the server, via its MCP server. The browser never sees this.
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini powers all LLM calls. Server-side only.
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Apify hosted MCP server (Streamable HTTP).
APIFY_MCP_URL=https://mcp.apify.com

# Model choices (see README for cost/speed rationale).
GEMINI_AGENT_MODEL=gemini-3.8-flash
GEMINI_UTILITY_MODEL=gemini-3.8-flash

# Safety caps so one user action can never get expensive.
MAX_RESULTS=20
ACTOR_RUN_TIMEOUT_SECS=180
MAX_CANDIDATES_TO_INSPECT=6

# Reliability: 3 retries per step, with per-attempt timeouts for search and reasoning (LLM).
STEP_MAX_RETRIES=3
SEARCH_TIMEOUT_SECS=30
REASONING_TIMEOUT_SECS=45

# Autonomous agent hard guardrails: step/tool/search budgets + overall deadline (seconds).
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=14
AGENT_MAX_SEARCHES=2
SEARCH_RESULTS_PER_QUERY=5
AGENT_TIMEOUT_SECS=150
